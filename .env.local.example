# Server-side API base (no trailing slash)
API_URL=https://deep-sky-server.onrender.com/api/v1
# Same value, exposed to the browser for client-side fetches + localStorage cache
NEXT_PUBLIC_API_URL=https://deep-sky-server.onrender.com/api/v1

# Must match JWT_SECRET in deep-sky-server/config.env
JWT_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_SITE_URL=https://www.deepskysociety.com
